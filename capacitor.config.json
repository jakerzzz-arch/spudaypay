{
  "appId": "com.spudaypay.music",
  "appName": "Spudaypay",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": [
      "*",
      "*.netlify.app",
      "*.apple.com",
      "*.mzstatic.com",
      "*.youtube.com",
      "*.googlevideo.com",
      "*.ytimg.com",
      "*.doubleclick.net",
      "*.jiosaavn.com",
      "*.saavn.com",
      "*.jio.com"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": false
  }
}
