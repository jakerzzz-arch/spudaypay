{
  "appId": "com.spudaypay.music",
  "appName": "Spudaypay",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": [
      "*.youtube.com",
      "*.googlevideo.com",
      "*.ytimg.com",
      "*.doubleclick.net",
      "*.mzstatic.com"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": false
  }
}
